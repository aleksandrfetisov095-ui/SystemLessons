<Window x:Class="EightLesson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EightLesson"
        mc:Ignorable="d"
        Title="Проверка" Height="450" Width="800">
    <Grid Background="LightBlue" Margin="10">
        <StackPanel>
            <TextBlock Text="Проверка Email" 
                       FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>


            <TextBlock Text="Введите email:" FontSize="16"/>

            <TextBox x:Name="EmailBox" FontSize="16" Height="30" 
                     Margin="0,5,0,10" Padding="5"/>
            <Button x:Name="CheckButton" Content="Проверить" 
                    FontSize="16" Height="40" Background="Green"
                    Foreground="White" FontWeight="Bold"
                    Click="CheckButton_Click"/>
            <Border BorderBrush="Gray" BorderThickness="2" 
                    CornerRadius="5" Margin="0,20,0,0" Padding="10">
                <TextBlock x:Name="ResultText" Text="Результат появится здесь" 
                           FontSize="16" TextWrapping="Wrap"/>
            </Border>

            
            <TextBlock Text="Примеры:" FontSize="14" Margin="0,10,0,5"/>
            <WrapPanel>
                <Button Content="test@mail.ru" Margin="2" Padding="5,2"
                        Click="Example_Click"/>
                <Button Content="hello@gmail.com" Margin="2" Padding="5,2"
                        Click="Example_Click"/>
                <Button Content="user@yandex.ru" Margin="2" Padding="5,2"
                        Click="Example_Click"/>
            </WrapPanel>

        </StackPanel>
    </Grid>
</Window>
