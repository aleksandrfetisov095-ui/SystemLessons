<Window x:Class="DataViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataViewer"
        mc:Ignorable="d"
        Title="Просмотр данных" Height="600" Width="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text=" UDP Монитор сообщений" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1" 
                Background="#f0f0f0" 
                Padding="10" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Button Content=" Загрузить из БД" 
                        Click="LoadFromDatabase_Click"
                        Padding="15,8" 
                        Margin="0,0,10,0"
                        Background="#3498db" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content=" Экспорт в CSV" 
                        Click="ExportToCsv_Click"
                        Padding="15,8" 
                        Margin="0,0,10,0"
                        Background="#27ae60" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content=" Отправить тестовые данные" 
                        Click="SendTestData_Click"
                        Padding="15,8" 
                        Margin="0,0,10,0"
                        Background="#f39c12" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content=" Очистить БД" 
                        Click="ClearDatabase_Click"
                        Padding="15,8"
                        Background="#e74c3c" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Таблица с данными -->
        <DataGrid Grid.Row="2" 
                  x:Name="MessagesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#f9f9f9"
                  BorderBrush="#ddd"
                  BorderThickness="1"
                  SelectionMode="Single" SelectionChanged="MessagesDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                        Binding="{Binding Id}" 
                        Width="50"/>
                <DataGridTextColumn Header="Сообщение" 
                        Binding="{Binding Content}" 
                        Width="*"/>
                <DataGridTextColumn Header="Время получения" 
                        Binding="{Binding ReceivedTime}" 
                        Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <Border Grid.Row="3" 
                Background="#ecf0f1" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" 
                           Text="Готов к работе" 
                           Foreground="#7f8c8d"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CounterText" 
                           Text="Всего записей: 0" 
                           Foreground="#2c3e50"
                           FontWeight="Bold"
                           Margin="20,0,0,0"/>

                <ProgressBar x:Name="LoadingProgressBar" 
                             Width="100" 
                             Height="15"
                             Margin="20,0,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
